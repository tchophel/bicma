POSTGRES_DB=cms
POSTGRES_USER=cms
POSTGRES_PASSWORD=cms
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
# Encrypts email, phone, CID and employee ID in the database. REQUIRED when DJANGO_DEBUG=0. Back it up: without it that data cannot be read.
# Make one with:  python3 -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173
BICMA_ADMIN_PASSWORD=change-me-to-a-strong-password
BICMA_ADMIN_EMAIL=admin@example.org

# Password reset: console delivery for development; use smtp.EmailBackend for real email.
FRONTEND_URL=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@example.org

# BCRS citizen registry: fills first/middle/last name when a CID is entered. See backend/core/bcrs.py.
# Use {cid} in the URL where the CID goes. Leave empty to disable (names are typed by hand).
BCRS_API_URL= https://staging-datahub-apim.tech.gov.bt/dcrc_citizen_details_api/1.0.0/citizendetails/{cid}
BCRS_API_METHOD=GET
BCRS_AUTH_HEADER=Authorization
BCRS_API_TOKEN=
# OAuth2 client credentials for BCRS (use these instead of BCRS_API_TOKEN):
BCRS_TOKEN_URL=
BCRS_CLIENT_ID=
BCRS_CLIENT_SECRET=

# Bhutan NDI staff sign-in (QR code + wallet). See backend/core/ndi.py. Leave the three secrets empty to disable it
# (the button then says it is not set up). Staff are matched by the CID stored on their account.
NDI_API_CLIENT_ID=
NDI_API_CLIENT_SECRET=
NDI_NATS_SEED_KEY=
NDI_API_HOST=https://demo-client.bhutanndi.com
NDI_API_AUTH_ENDPOINT=https://staging.bhutanndi.com/authentication/v1/authenticate
NDI_NATS_HOST=https://natsdemoclient.bhutanndi.com
NDI_NATS_PORT=4222
NDI_FOUNDATIONAL_ID_CRED_DEF_ID=https://schema.ngotag.com/schemas/fb675203-b317-4675-a657-be7f5d1d57fb

# Optional virus scanning of uploaded files with ClamAV (the built-in safety checks always run).
# Start the scanner:  docker compose --profile scan up -d clamav   then set the host below.
CLAMAV_HOST=
CLAMAV_REQUIRED=0

# Automated security checks (Settings > Security scan). Leave blank what you do not use.
GITHUB_REPO=
GITHUB_TOKEN=
SONARQUBE_URL=
SONARQUBE_PROJECT=
SONARQUBE_TOKEN=
ZAP_URL=
ZAP_TARGET=
ZAP_API_KEY=
